NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — bypasses RLS, must never be NEXT_PUBLIC_ prefixed.
SUPABASE_SECRET_KEY=

# Clinic booking notifications (SMTP).
# Leave blank to disable: bookings still save, no email is sent.
# Server-only — SMTP_PASSWORD must never be NEXT_PUBLIC_ prefixed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER. Most providers reject a From that isn't the
# authenticated mailbox; "Wellness Clinic <bookings@example.com>" also works.
SMTP_FROM=
# Where new bookings land. Comma-separate for more than one recipient.
CLINIC_NOTIFICATION_EMAIL=
